{
  // DAKA Ontology 本地调试配置（仅本地端口，不涉及任何远端/Preview）。
  // 用法详见 docs/debugging.md。断点应落在 TypeScript 源文件上：
  //   - packages/ontology-runtime/src/actions/engine.ts   （action 执行链）
  //   - packages/ontology-runtime/src/actions/handlers.ts （effect handler）
  //   - packages/ontology-runtime/src/policy.ts           （policy/RLS 授权）
  //   - packages/ontology-runtime/src/rules/runner.ts     （rule runner）
  //   - worker/ontology/api.ts                            （API 路由装配）
  {
    "version": "0.2.0",
    "configurations": [
      {
        // ① 先跑这个：终端内启动 dev server 并打开 workerd inspector（localhost:9229）
        "name": "1) Dev server + workerd inspector (terminal)",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm exec vite dev --inspect"
      },
      {
        // ② dev server 起来后：附加到 workerd V8 inspector，即可打真实断点
        "name": "2) Attach to Worker inspector (:9229)",
        "type": "node",
        "request": "attach",
        "port": 9229,
        "restart": true,
        "sourceMaps": true,
        // workerd 的 source map 路径与磁盘路径不一致，放开位置解析
        "resolveSourceMapLocations": null,
        "skipFiles": ["<node_internals/**>", "**/node_modules/**"]
      },
      {
        // 调试验收/契约测试（vitest，Node 进程）
        "name": "Debug vitest (ontology packages)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["--filter", "./packages/*", "exec", "vitest", "run", "--inspect-brk"],
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals/**>", "**/node_modules/**"]
      },
      {
        // 前端页面调试：以独立用户目录启动 Chrome（仅本地 127.0.0.1 调试端口）
        "name": "Chrome (frontend, localhost)",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}",
        "sourceMaps": true
      }
    ]
  }
}
