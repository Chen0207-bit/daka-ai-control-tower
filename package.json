{
  "name": "daka-ai-control-tower",
  "version": "1.2.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r --filter \"./packages/*\" --if-present test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern ontology/.generated",
    "db:generate": "drizzle-kit generate",
    "ontology:validate": "pnpm --filter @daka/ontology-dsl run validate",
    "ontology:compile": "pnpm --filter @daka/ontology-dsl run compile",
    "ontology:check-generated": "pnpm --filter @daka/ontology-dsl run check-generated",
    "ontology:diff": "pnpm --filter @daka/ontology-dsl run diff",
    "ontology:inspect": "pnpm --filter @daka/ontology-dsl run inspect",
    "db:migrate": "pnpm --filter @daka/ontology-runtime exec tsx src/db/migrate.ts",
    "db:verify": "pnpm --filter @daka/ontology-runtime exec tsx src/db/migrate.ts verify",
    "seed:demo": "pnpm --filter @daka/ontology-runtime exec tsx src/ingest/seed-cli.ts",
    "seed:demo:dry": "pnpm --filter @daka/ontology-runtime exec tsx src/ingest/seed-cli.ts --dry-run",
    "test:e2e": "node scripts/e2e-api.mjs",
    "test:integration": "pnpm --filter @daka/ontology-runtime run test",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "dependencies": {
    "@daka/ontology-client": "workspace:^",
    "@daka/ontology-dsl": "workspace:^",
    "@daka/ontology-runtime": "workspace:^",
    "drizzle-orm": "0.45.2",
    "pg": "^8.13.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
